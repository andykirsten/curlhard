# Kopieren nach deploy/.env (Rechte 600) und Werte anpassen
SECRET_KEY=change-me-to-a-long-random-string
# Passwort des Postgres-Containers; die DATABASE_URL baut compose.yaml daraus zusammen
POSTGRES_PASSWORD=change-me-to-another-long-random-string
CURLHARD_TAG=latest
GHCR_OWNER=your-github-user-or-org
# Muss gesetzt sein, damit das Session-Cookie nur über HTTPS gesendet wird
COOKIE_SECURE=true
# Origin(s), die schreibende Requests senden dürfen (JSON-Liste), z. B. ["https://203-0-113-5.sslip.io"]
ALLOWED_ORIGINS=["https://203-0-113-5.sslip.io"]
# Optional: Cloudflare Tunnel (Token aus dem Cloudflare-Dashboard), aktiviert den Dienst "tunnel"
#COMPOSE_PROFILES=tunnel
#CLOUDFLARE_TUNNEL_TOKEN=
